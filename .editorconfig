# EditorConfig — https://editorconfig.org
# Keeps whitespace and line endings consistent across editors.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{toml,yaml,yml}]
indent_size = 2

[*.{ts,js,json}]
indent_size = 2

[*.md]
# Trailing spaces are significant in Markdown (line breaks)
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2
